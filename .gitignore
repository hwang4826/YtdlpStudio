# 1. Python 컴파일 및 캐시 파일 (사진에 있는 localpycs 폴더 및 .pyc 포함)
__pycache__
.py[cod]
$py.class
localpycs

# 2. PyInstaller 빌드 찌꺼기 파일 (사진에 있는 각종 임시 파일들)
build
dist
.spec
